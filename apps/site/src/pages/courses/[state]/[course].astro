---
import { z } from "zod";
import { courseBySlug, outingsForCourse } from "@gof/db/queries";
import { buildItemListJsonLd } from "@gof/shared/jsonld";
import { isPast } from "@gof/shared/dates";
import { OSM_ATTRIBUTION_TEXT } from "@gof/shared/places";
import type { CourseType } from "@gof/shared/schemas";
import Base from "../../../layouts/Base.astro";
import TeeSheet from "../../../components/TeeSheet.astro";
import { getDb } from "../../../lib/db.ts";
import { requestNow } from "../../../lib/clock.ts";
import { TTL } from "../../../lib/cache.ts";
import { notFound, setCache } from "../../../lib/page.ts";
import { COURSE_TYPE_LABELS, placeText, stateName } from "../../../lib/format.ts";
import { absoluteUrl, cityPath, coursePath, outingPath, statePath } from "../../../lib/urls.ts";

export const prerender = false;

const params = z
  .object({
    state: z.string().regex(/^[a-z]{2}$/),
    course: z.string().max(200).regex(/^[a-z0-9]+(-[a-z0-9]+)*$/),
  })
  .safeParse(Astro.params);
if (!params.success) return notFound(Astro);

const db = getDb();
// Courses that never had a published outing return 404 (SPEC.md 9.1).
const course = await courseBySlug(db, `${params.data.state}/${params.data.course}`);
if (!course) return notFound(Astro);

const now = requestNow();
const all = await outingsForCourse(db, course.id);
const isDone = (o: (typeof all)[number]) =>
  o.status === "past" || (o.status !== "expected" && o.startDate !== null && isPast(o.startDate, o.endDate, now, o.course.timeZone));
const upcoming = all.filter((o) => o.status !== "expected" && !isDone(o)).reverse();
const expected = all.filter((o) => o.status === "expected");
const past = all.filter(isDone);

const place = placeText(course.city, course.state);
const typeLabel = COURSE_TYPE_LABELS[course.courseType as CourseType] ?? "Course type unknown";
const path = coursePath(course.slug);
let website: string | null = null;
try {
  if (course.website) {
    const u = new URL(course.website);
    if (u.protocol === "https:" || u.protocol === "http:") website = u.href;
  }
} catch {
  website = null;
}
const crumbs = [
  { name: "Golf outings", path: "/golf-outings" },
  { name: stateName(course.state), path: statePath(course.state) },
  ...(course.city ? [{ name: course.city, path: cityPath(course.state, course.city) }] : []),
  { name: course.name, path },
];
const typeSentence: Record<string, string> = {
  municipal: "a municipal course",
  public: "a public course",
  semi_private: "a semi-private club",
  private: "a private club",
  resort: "a resort course",
  unknown: "a golf course",
};

setCache(Astro, TTL.list);
---

<Base
  title={`Golf Outings at ${course.name}, ${place}`}
  description={`${upcoming.length} upcoming and ${expected.length} expected golf outings at ${course.name}, ${typeSentence[course.courseType] ?? "a golf course"} in ${place}. Dates, prices and registration links.`}
  path={path}
  crumbs={crumbs}
  jsonLd={[buildItemListJsonLd([...upcoming, ...expected, ...past].map((o) => absoluteUrl(outingPath(o.slug))))]}
>
  <h1>Golf outings at {course.name}</h1>
  <p>
    {course.name} is {typeSentence[course.courseType] ?? "a golf course"} in {place}.
    {course.courseType === "private" && " Members-only most days, but these outings are open to anyone who registers."}
  </p>
  <dl class="facts scorecard">
    <div><dt>Course type</dt><dd>{typeLabel}</dd></div>
    {course.street && <div><dt>Address</dt><dd>{course.street}, {place}{course.zip && <> {course.zip}</>}</dd></div>}
    {website && <div><dt>Website</dt><dd><a href={website} rel="nofollow noopener">{new URL(website).hostname.replace(/^www\./, "")}</a></dd></div>}
  </dl>

  <section aria-labelledby="upcoming">
    <h2 id="upcoming">Upcoming outings</h2>
    {upcoming.length === 0 ? <p>No dated outings coming up right now.</p> : <TeeSheet outings={upcoming} />}
  </section>
  {
    expected.length > 0 && (
      <section aria-labelledby="expected">
        <h2 id="expected">Expected to return</h2>
        <TeeSheet outings={expected} />
      </section>
    )
  }
  {
    past.length > 0 && (
      <section aria-labelledby="past">
        <h2 id="past">Past outings</h2>
        <TeeSheet outings={past} alwaysYear />
      </section>
    )
  }
  {course.city && <p><a href={cityPath(course.state, course.city)}>More golf outings in {course.city}</a></p>}
  <p class="small muted">Course name and location {OSM_ATTRIBUTION_TEXT} (<a href="https://www.openstreetmap.org/copyright">ODbL</a>).</p>
</Base>
