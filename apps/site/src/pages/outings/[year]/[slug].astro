---
import { z } from "zod";
import { nearbyUpcomingOutings, outingById, outingBySlug } from "@gof/db/queries";
import { buildEventJsonLd } from "@gof/shared/jsonld";
import { isPast } from "@gof/shared/dates";
import { milesToKm } from "@gof/shared/places";
import Base from "../../../layouts/Base.astro";
import Labels from "../../../components/Labels.astro";
import TeeSheet from "../../../components/TeeSheet.astro";
import AdSlot from "../../../components/AdSlot.astro";
import { siteAdsConfig } from "../../../lib/ads-env.ts";
import { getDb } from "../../../lib/db.ts";
import { listToday, requestNow } from "../../../lib/clock.ts";
import { TTL } from "../../../lib/cache.ts";
import { notFound, setCache } from "../../../lib/page.ts";
import { clip, FORMAT_LABELS, stateName, verifiedDate } from "../../../lib/format.ts";
import { outingTitle, outingView } from "../../../lib/outing-view.ts";
import { absoluteUrl, cityPath, coursePath, organizerPath, outingPath, statePath } from "../../../lib/urls.ts";
import { guideLinks } from "../../../lib/guides.ts";

export const prerender = false;

const params = z
  .object({
    year: z.string().regex(/^\d{4}$/),
    slug: z.string().max(200).regex(/^[a-z0-9]+(-[a-z0-9]+)*$/),
  })
  .safeParse(Astro.params);
if (!params.success) return notFound(Astro);

const db = getDb();
const o = await outingBySlug(db, `${params.data.year}/${params.data.slug}`);
if (!o) return notFound(Astro);

const now = requestNow();
const v = outingView(o);
const path = outingPath(o.slug);
const dated = o.status !== "expected" && o.startDate !== null;
const passed = o.status === "past" || (dated && o.startDate !== null && isPast(o.startDate, o.endDate, now, o.course.timeZone));
const canRegister = !passed && !v.isExpected && o.status !== "cancelled" && o.status !== "sold_out";
const [nearby, next, newcomerGuides] = await Promise.all([
  nearbyUpcomingOutings(db, {
    center: { lat: o.course.lat, lng: o.course.lng },
    radiusKm: milesToKm(100),
    today: listToday(now),
    excludeId: o.id,
    limit: 5,
  }),
  o.nextOutingId ? outingById(db, o.nextOutingId) : Promise.resolve(null),
  guideLinks(["playing-an-outing-as-a-single", "what-an-entry-fee-includes"]),
]);

const event = buildEventJsonLd({
  url: absoluteUrl(path),
  title: o.title,
  summary: o.summary,
  status: o.status,
  startDate: o.startDate,
  endDate: o.endDate,
  shotgunTime: o.shotgunTime,
  singlePriceCents: o.singlePriceCents,
  foursomePriceCents: o.foursomePriceCents,
  registrationUrl: o.registrationUrl,
  canonicalSourceUrl: o.canonicalSourceUrl,
  course: o.course,
  organizer: o.organizer ? { name: o.organizer.name, website: o.organizer.website } : null,
});

const title = outingTitle(o);
const description = clip(
  o.summary ??
    `${o.label} at ${o.course.name} in ${v.place}. ${v.when}${v.time ? `, ${v.time}` : ""}. ${v.price}. ${
      v.isExpected ? "Expected to return; we'll post the date when the organizer does." : "Details and the registration link."
    }`,
  300,
);
let sourceHost = "";
try {
  sourceHost = new URL(o.canonicalSourceUrl).hostname.replace(/^www\./, "");
} catch {
  sourceHost = "the organizer's site";
}
const crumbs = [
  { name: "Golf outings", path: "/golf-outings" },
  { name: stateName(o.course.state), path: statePath(o.course.state) },
  ...(o.course.city ? [{ name: o.course.city, path: cityPath(o.course.state, o.course.city) }] : []),
  { name: o.title, path },
];

// Two columns with a desktop sidebar unit only when ads are on (SPEC.md 9.5).
const adsOn = siteAdsConfig().enabled;

setCache(Astro, TTL.list);
---

<Base title={title} description={description} path={path} noindex={o.sourceGone} crumbs={crumbs} jsonLd={event ? [event] : []}>
  <div class:list={["outing-layout", { "has-sidebar": adsOn }]}>
    <div class="outing-main">
      <article class="outing">
        <h1>{o.title}</h1>
        <p class="where data">
          <a href={coursePath(o.course.slug)}>{o.course.name}</a>, {v.place}
        </p>
        <p class="when data">{v.when}{v.time && <span class="when-time">, {v.time}</span>}</p>
        <Labels courseTypeLabel={v.courseTypeLabel} label={o.label} status={o.status} />

        {o.sourceGone && <p class="note">The organizer's page for this outing is gone. Check with the organizer before making plans.</p>}
        {o.status === "cancelled" && <p class="note alert">The organizer has cancelled this outing.</p>}
        {passed && <p class="note">This outing has already been played.{next && <> The next one is <a href={outingPath(next.slug)}>{next.title}</a>.</>}</p>}
        {
          v.isExpected && (
            <p class="note">
              {o.startDate
                ? "The organizer has announced this date, but registration isn't confirmed open yet."
                : "This outing usually runs every year. We'll update this page when the organizer posts the date."}
            </p>
          )
        }

        {o.summary && <p class="summary">{o.summary}</p>}

        <div class="actions">
          {
            canRegister && (
              <a class="button" href={o.registrationUrl ?? o.canonicalSourceUrl} rel="nofollow noopener" target="_blank">
                {o.registrationUrl ? "Register" : "See site"}
                <span class="visually-hidden"> (opens the organizer's site)</span>
              </a>
            )
          }
          <span class="small muted">Last verified {verifiedDate(o.lastVerified)}</span>
        </div>

        <h2>Details</h2>
        <dl class="details scorecard">
          <div><dt>When</dt><dd class="num">{v.when}{v.time && <>, {v.time}</>}</dd></div>
          <div>
            <dt>Course</dt>
            <dd>
              <a href={coursePath(o.course.slug)}>{o.course.name}</a>
              {o.course.street && <>, {o.course.street}</>}, {v.place}{o.course.zip && <> {o.course.zip}</>}
            </dd>
          </div>
          <div><dt>Course type</dt><dd>{v.courseTypeLabel}</dd></div>
          <div>
            <dt>Outing type</dt>
            <dd>
              {o.label}
              {o.label === "Charity" && <span class="muted"> (listed as a 501(c)(3) in IRS records)</span>}
            </dd>
          </div>
          {o.format && <div><dt>Format</dt><dd>{FORMAT_LABELS[o.format]}</dd></div>}
          <div><dt>Price</dt><dd class="num">{v.price}</dd></div>
          {v.includes && <div><dt>What's included</dt><dd>{v.includes}</dd></div>}
          {o.handicapRequired !== null && <div><dt>Handicap</dt><dd>{o.handicapRequired ? "A handicap is required" : "No handicap needed"}</dd></div>}
          {o.audienceNote && <div><dt>Who it's for</dt><dd>{o.audienceNote}</dd></div>}
          {
            o.organizer && (
              <div>
                <dt>Organizer</dt>
                <dd><a href={organizerPath(o.organizer.slug)}>{o.organizer.name}</a></dd>
              </div>
            )
          }
          <div><dt>Source</dt><dd><a href={o.canonicalSourceUrl} rel="nofollow noopener">{sourceHost}</a></dd></div>
          <div><dt>Last verified</dt><dd class="num">{verifiedDate(o.lastVerified)}</dd></div>
        </dl>
        <p class="small muted">
          We summarize outings in our own words from the organizer's page. Prices and details can change, so confirm them with the
          organizer before you pay. Something wrong? <a href="/corrections">Tell us</a>.
        </p>
        {
          newcomerGuides.length > 0 && (
            <p class="small newcomer">
              New to outings?{" "}
              {newcomerGuides.map((g, i) => (
                <>
                  {i > 0 && " · "}
                  <a href={g.path}>{g.title}</a>
                </>
              ))}
            </p>
          )
        }
      </article>

      <AdSlot placement="outing" />

      {
        nearby.length > 0 && (
          <section aria-labelledby="nearby">
            <h2 id="nearby">Upcoming outings nearby</h2>
            <TeeSheet outings={nearby} />
          </section>
        )
      }
      <p class="more data">
        More: <a href={coursePath(o.course.slug)}>outings at {o.course.name}</a>
        {o.course.city && <> · <a href={cityPath(o.course.state, o.course.city)}>outings in {o.course.city}</a></>}
        {o.organizer && <> · <a href={organizerPath(o.organizer.slug)}>outings by {o.organizer.name}</a></>}
      </p>
    </div>
    {
      adsOn && (
        <div class="outing-side">
          <AdSlot placement="sidebar" />
        </div>
      )
    }
  </div>
</Base>

<style>
  /* Desktop: content and a 300px ad column (SPEC.md 9.5). Phones and tablets: one column, no sidebar. */
  @media (min-width: 1024px) {
    .outing-layout.has-sidebar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 0 2.5rem;
      align-items: start;
    }
    .outing-side {
      position: sticky;
      top: 1rem;
      padding-top: 1rem;
    }
  }
  @media (max-width: 1023.98px) {
    .outing-side {
      display: none;
    }
  }
  .where {
    font-size: 1.125rem;
    margin: 0 0 0.25rem;
  }
  .where a {
    text-decoration: none;
  }
  .where a:hover {
    text-decoration: underline;
  }
  .when {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.25rem;
  }
  .when-time {
    font-weight: 400;
  }
  @media (min-width: 720px) {
    .when {
      font-size: 1.375rem;
    }
  }
  .summary {
    font-size: 1.125rem;
    margin: 1.25rem 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 1.25rem 0;
  }
  .actions .button {
    min-width: 9rem;
  }
</style>
