---
import { z } from "zod";
import { countUpcomingByState, listUpcomingOutings, searchCities, zipLookup } from "@gof/db/queries";
import { buildItemListJsonLd } from "@gof/shared/jsonld";
import { US_STATES } from "@gof/shared/places";
import Base from "../layouts/Base.astro";
import TeeSheet from "../components/TeeSheet.astro";
import Photo from "../components/Photo.astro";
import { HERO_PHOTO, HERO_TALL_WIDTHS, HERO_WIDE_WIDTHS, photoSrcset } from "../lib/photos.ts";
import { getDb } from "../lib/db.ts";
import { listToday, siteYear } from "../lib/clock.ts";
import { TTL } from "../lib/cache.ts";
import { setCache } from "../lib/page.ts";
import { absoluteUrl, cityPath, outingPath, statePath } from "../lib/urls.ts";
import { siteEnv } from "../lib/env.ts";
import { GUIDES_PATH, guideLinks } from "../lib/guides.ts";

// Search Console and Bing verification (SPEC.md 13 Phase 3): the home page only,
// and only when the Worker var is set.
const { GOOGLE_SITE_VERIFICATION: googleVerification, BING_SITE_VERIFICATION: bingVerification } = siteEnv();

const db = getDb();
const today = listToday();

// City or ZIP search: resolve and redirect to the city page.
const qParam = z.string().trim().min(2).max(100).safeParse(Astro.url.searchParams.get("q") ?? "");
let searchMessage = "";
let suggestions: { name: string; state: string; slug: string }[] = [];
if (Astro.url.searchParams.has("q")) {
  if (!qParam.success) {
    searchMessage = "Type a city name or a five-digit ZIP code.";
  } else {
    const q = qParam.data;
    if (/^\d{5}$/.test(q)) {
      const z5 = await zipLookup(db, q);
      if (z5?.city && z5.state) return Astro.redirect(cityPath(z5.state, z5.city), 302);
      searchMessage = `We don't know ZIP code ${q} yet. Try the nearest city name.`;
    } else {
      const m = /^(.*?)[,\s]+([a-z]{2})$/i.exec(q);
      const st = m?.[2]?.toUpperCase();
      const name = (m && st && Object.hasOwn(US_STATES, st) ? (m[1] ?? "") : q).trim();
      const found = await searchCities(db, name, 50);
      const inState = st && Object.hasOwn(US_STATES, st) ? found.filter((c) => c.state === st) : found;
      const exact = inState.filter((c) => c.name.toLowerCase() === name.toLowerCase());
      const pick = exact.length === 1 ? exact[0] : exact.length === 0 && inState.length === 1 ? inState[0] : undefined;
      if (pick) return Astro.redirect(cityPath(pick.state, pick.name), 302);
      suggestions = (exact.length > 1 ? exact : inState).slice(0, 12);
      searchMessage = suggestions.length > 0 ? `Which ${name}?` : `We couldn't find a city called "${name}". Check the spelling or try a ZIP code.`;
    }
  }
}

const soonest = await listUpcomingOutings(db, { today, limit: 12 });
const counts = await countUpcomingByState(db, today);
const countBy = new Map(counts.map((c) => [c.state, c.count]));
// The four census regions, so the directory reads as a map of the country rather than an A to Z.
const REGIONS: readonly { name: string; codes: readonly string[] }[] = [
  { name: "Northeast", codes: ["CT", "ME", "MA", "NH", "NJ", "NY", "PA", "RI", "VT"] },
  { name: "South", codes: ["AL", "AR", "DE", "DC", "FL", "GA", "KY", "LA", "MD", "MS", "NC", "OK", "SC", "TN", "TX", "VA", "WV"] },
  { name: "Midwest", codes: ["IL", "IN", "IA", "KS", "MI", "MN", "MO", "NE", "ND", "OH", "SD", "WI"] },
  { name: "West", codes: ["AK", "AZ", "CA", "CO", "HI", "ID", "MT", "NV", "NM", "OR", "UT", "WA", "WY"] },
];
const stateName = (code: string): string => (US_STATES as Record<string, string>)[code] ?? code;
const regions = REGIONS.map((r) => ({
  name: r.name,
  states: r.codes.map((code) => ({ code, name: stateName(code), count: countBy.get(code) ?? 0 })).sort((a, b) => a.name.localeCompare(b.name)),
}));
const totalUpcoming = counts.reduce((n, c) => n + c.count, 0);
// Three guides a first-timer reads before signing up, when this build renders them.
const guides = await guideLinks(["how-charity-golf-outings-work", "what-is-a-golf-scramble", "what-an-entry-fee-includes"]);

setCache(Astro, TTL.home);
---

<Base
  title="Golf Outings and Charity Tournaments Near You | Golf Outing Finder"
  description="Find golf outings anyone can pay to enter, from $125 muni scrambles to charity days at private clubs. Dates, prices, what's included and registration links, across the US."
  path="/"
  noindex={Astro.url.searchParams.has("q")}
  jsonLd={[buildItemListJsonLd(soonest.map((o) => absoluteUrl(outingPath(o.slug))))]}
  home
>
  {googleVerification && <meta slot="head" name="google-site-verification" content={googleVerification} />}
  {bingVerification && <meta slot="head" name="msvalidate.01" content={bingVerification} />}
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    media="(orientation: portrait)"
    imagesrcset={photoSrcset(HERO_PHOTO, "hero-m", HERO_TALL_WIDTHS, "avif")}
    imagesizes="100vw"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    media="(orientation: landscape)"
    imagesrcset={photoSrcset(HERO_PHOTO, "hero", HERO_WIDE_WIDTHS, "avif")}
    imagesizes="100vw"
    fetchpriority="high"
  />

  <section class="hero" aria-labelledby="hero-title">
    <Photo photo={HERO_PHOTO} kind="hero" />
    <div class="scrim hero-scrim"></div>
    <div class="hero-inner">
      <h1 id="hero-title" class="hero-title">Golf outings anyone can enter</h1>
      <p class="hero-tagline">Charity scrambles, school fundraisers and open days, from the muni down the road to the club across town.</p>
      <form class="search" method="get" action="/" role="search">
        <label for="q">Search by city or ZIP code</label>
        <div class="search-row">
          <input id="q" name="q" type="search" autocomplete="off" placeholder="Mamaroneck, NY or 10543" maxlength="100" required />
          <button class="button" type="submit">Find outings</button>
        </div>
      </form>
    </div>
  </section>

  <div class="wrap">
    {
      searchMessage && (
        <div class="note search-note" role="status">
          <p>{searchMessage}</p>
          {suggestions.length > 0 && (
            <ul class="grid-links">
              {suggestions.map((c) => (
                <li>
                  <a href={cityPath(c.state, c.name)}>
                    {c.name}, {c.state}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }

    <p class="intro">
      Every listing shows the date, the course, the price and how to register, checked against the organizer's own page.
    </p>

    <section aria-labelledby="soonest" class="home-section">
      <div class="section-head">
        <h2 id="soonest">Coming up</h2>
        <p class="section-aside">
          <a href="/golf-outings">
            {totalUpcoming > soonest.length ? `All ${totalUpcoming} upcoming outings, by state` : "Outings by state"}
          </a>
        </p>
      </div>
      {soonest.length === 0 ? <p>No upcoming outings listed yet.</p> : <TeeSheet outings={soonest} />}
    </section>
  </div>

  <section aria-labelledby="near" class="near" data-needs-js>
    <Photo photo="flag-at-dusk" kind="band" lazy />
    <div class="scrim near-scrim"></div>
    <div class="wrap near-inner">
      <h2 id="near">Outings near you</h2>
      <p class="near-status" data-near-status aria-live="polite">
        Share your location to see outings within 100 miles. We don't store it.
      </p>
      <p class="near-action"><button class="button" type="button" data-near-button>Use my location</button></p>
    </div>
  </section>
  <div class="wrap near-results" data-needs-js>
    <ul class="tee-sheet" data-near-list data-year={String(siteYear())}></ul>
  </div>

  <section aria-labelledby="states" class="states-band">
    <div class="wrap">
      <div class="section-head">
        <h2 id="states">Browse by state</h2>
        <p class="section-aside"><a href="/map">See them on a map</a></p>
      </div>
      <div class="regions">
        {
          regions.map((r) => (
            <div class="region">
              <h3 class="region-name">{r.name}</h3>
              <ul class="state-list">
                {r.states.map((st) => (
                  <li>
                    <a href={statePath(st.code)}>{st.name}</a>
                    {st.count > 0 && <span class="state-count num"> {st.count}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    guides.length > 0 && (
      <section aria-labelledby="guides" class="wrap home-section guides-section">
        <div class="section-head">
          <h2 id="guides">New to outings?</h2>
          <p class="section-aside">
            <a href={GUIDES_PATH}>All guides</a>
          </p>
        </div>
        <ul class="guide-cards">
          {guides.map((g) => (
            <li>
              <a href={g.path}>{g.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  /* The first screen: one photograph, the promise set large at its foot, and the search. */
  .hero {
    --link: var(--band-fg);
    --focus: var(--band-fg);
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 78vh;
    min-height: 78svh;
    padding: 9rem 0 2.5rem;
    color: var(--band-fg);
    background: var(--band);
    overflow: hidden;
    isolation: isolate;
  }
  @media (min-width: 720px) {
    .hero {
      min-height: 92vh;
      min-height: 92svh;
      padding: 10rem 0 4.5rem;
    }
  }
  /* Darker at the top (the nav) and at the foot (the headline); the fairway shows between. */
  .hero-scrim {
    background: linear-gradient(
      180deg,
      rgb(20 41 31 / 0.5),
      rgb(20 41 31 / 0.16) 26%,
      rgb(20 41 31 / 0.3) 52%,
      rgb(20 41 31 / 0.8) 82%,
      rgb(20 41 31 / 0.92)
    );
  }
  .hero-inner {
    position: relative;
    width: 100%;
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The headline settles in; the search is there from the first frame. */
    .hero-title,
    .hero-tagline {
      animation: hero-in 900ms ease-out both;
    }
    @keyframes hero-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
    }
  }
  .hero-title {
    margin: 0;
    max-width: 15ch;
    color: var(--band-fg);
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.3);
  }
  .hero-tagline {
    margin: 1.5rem 0 0;
    max-width: 38ch;
    font-family: var(--display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.3125rem, 2.6vw, 1.75rem);
    line-height: 1.3;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }

  /* The search: a paper panel at the foot of the photograph, like a booking bar. */
  .search {
    margin: 2.5rem 0 0;
    max-width: 40rem;
    padding: 1rem 1rem 1rem 1.25rem;
    background: var(--page);
    color: var(--ink);
    --focus: var(--fairway);
  }
  .search label {
    display: block;
    font-family: var(--label);
    font-size: 0.75rem;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .search-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .search input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.1875rem;
  }
  .search input::placeholder {
    color: var(--ink-muted);
    font-style: italic;
    opacity: 1;
  }
  .search input:focus-visible {
    outline: none;
    box-shadow: 0 1px 0 var(--fairway);
  }
  .search .button {
    flex: none;
    min-height: 52px;
  }
  @media (max-width: 479.98px) {
    .search {
      padding: 1rem;
    }
    .search-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
  }

  .search-note {
    margin: 2.5rem 0 0;
    max-width: 46rem;
  }
  .intro {
    margin: var(--space-section) 0 0;
    max-width: 24ch;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.875rem, 4.4vw, 3.25rem);
    line-height: 1.12;
    color: var(--title);
    text-wrap: balance;
  }
  @media (min-width: 720px) {
    .intro {
      max-width: 30ch;
    }
  }
  .home-section h2,
  .states-band h2 {
    margin-top: 0;
    margin-bottom: 0;
  }
  .home-section {
    margin-top: var(--space-section);
  }
  /* A section heading with one quiet link opposite it. */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 1.25rem;
  }
  .section-aside {
    margin: 0 0 0.375rem;
    font-style: italic;
  }

  /* Near you: a second photograph, full width, with the one action in it. */
  .near {
    --link: var(--band-fg);
    --focus: var(--band-fg);
    position: relative;
    margin-top: var(--space-section);
    padding: clamp(4rem, 10vw, 7.5rem) 0;
    color: var(--band-fg);
    background: var(--band);
    overflow: hidden;
    isolation: isolate;
  }
  .near-scrim {
    background: linear-gradient(90deg, rgb(20 41 31 / 0.9), rgb(20 41 31 / 0.72) 55%, rgb(20 41 31 / 0.45));
  }
  .near-inner {
    position: relative;
  }
  .near h2 {
    margin: 0;
    color: var(--band-fg);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
  }
  .near-status {
    margin: 1rem 0 0;
    max-width: 40ch;
    font-size: 1.1875rem;
  }
  .near-action {
    margin: 1.75rem 0 0;
  }
  .near .button {
    --btn: var(--band-fg);
    --btn-hover: #ffffff;
    --btn-fg: #14291f;
  }
  .near-results .tee-sheet {
    margin-top: 2.5rem;
  }
  .tee-sheet:empty {
    display: none;
  }

  /* States, by region, on linen. */
  .states-band {
    padding: var(--space-section) 0;
    background: var(--surface);
  }
  .near + .near-results + .states-band {
    margin-top: 0;
  }
  .regions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule-strong);
  }
  @media (min-width: 860px) {
    .regions {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 3rem;
    }
  }
  .region-name {
    margin: 0 0 0.75rem;
    font-family: var(--label);
    font-size: 0.75rem;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .state-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .state-list li {
    padding: 0.3125rem 0;
  }
  .state-list a {
    color: var(--title);
    text-decoration: none;
  }
  .state-list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .state-count {
    margin-left: 0.375rem;
    font-size: 0.875rem;
    font-style: italic;
    color: var(--ink-muted);
  }

  /* Guides: three titles set as large links between rules. */
  .guides-section {
    margin-bottom: var(--space-section);
  }
  .guide-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule-strong);
  }
  @media (min-width: 860px) {
    .guide-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 3rem;
    }
  }
  .guide-cards li {
    max-width: none;
    border-bottom: 1px solid var(--rule);
  }
  .guide-cards a {
    display: block;
    padding: 1.5rem 0 1.75rem;
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.625rem;
    line-height: 1.2;
    color: var(--title);
    text-decoration: none;
  }
  .guide-cards a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
</style>

<script>
  import { initNearYou } from "../scripts/near-you.ts";
  initNearYou();
</script>
