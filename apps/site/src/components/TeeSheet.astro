---
/**
 * A list of outings as a tee sheet: rows between gilt hairlines, the date in the
 * left column like a scorecard's hole numbers (weekday in italic, the day as a
 * large numeral, the month in small capitals). Row styles live here as global CSS
 * so the home page's near-you rows (built in the browser) match.
 */
import type { OutingListItem } from "@gof/db/queries";
import type { ListingFilters } from "@gof/shared/filters";
import type { LatLng } from "@gof/shared/places";
import AdSlot from "./AdSlot.astro";
import TeeSheetRow from "./TeeSheetRow.astro";
import { isVisible } from "../lib/listing.ts";
import type { ListAd } from "../lib/ads.ts";

interface Props {
  outings: readonly OutingListItem[];
  center?: LatLng | null;
  /** Server-side filters (city and state pages); rows they exclude render hidden. */
  filters?: ListingFilters;
  /** Always show the year in the date column (a course's past outings). */
  alwaysYear?: boolean;
  /** List ad units (lib/ads.ts listAdSlots), by row index into `outings`. */
  adSlots?: readonly ListAd[];
}

const { outings, center = null, filters, alwaysYear = false, adSlots = [] } = Astro.props;
const adAfter = new Map(adSlots.map((a) => [a.afterIndex, a.ordinal]));
---

<ul class="tee-sheet">
  {
    outings.map((o, i) => (
      <>
        <TeeSheetRow outing={o} center={center} hidden={filters ? !isVisible(o, filters, center) : false} alwaysYear={alwaysYear} />
        {adAfter.has(i) && <AdSlot placement="list" ordinal={adAfter.get(i)} listItem />}
      </>
    ))
  }
</ul>

<style is:global>
  /* Rows lay out by the sheet's own width, so a sheet beside the outing page's ad column stays in its narrow form. */
  .tee-sheet {
    container-type: inline-size;
    list-style: none;
    margin: 0.75rem 0 1.75rem;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .tee-row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    grid-template-areas:
      "date main"
      "date price"
      "date action";
    gap: 0.5rem 1rem;
    max-width: none;
    padding: 1.25rem 0 1.375rem;
    border-bottom: 1px solid var(--rule);
  }
  .tee-row p {
    margin: 0;
  }
  .tee-date {
    grid-area: date;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-right: 0.875rem;
    border-right: 1px solid var(--rule);
    text-align: center;
    line-height: 1.15;
    color: var(--title);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .tee-date-top {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--ink-muted);
  }
  .tee-date-big {
    font-family: var(--display);
    font-size: 1.875rem;
    line-height: 1.15;
    white-space: nowrap;
  }
  .tee-date-bottom {
    font-family: var(--display);
    font-size: 0.6875rem;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .tee-main {
    grid-area: main;
    min-width: 0;
  }
  .tee-title {
    font-family: var(--serif);
    font-size: 1.1875rem;
    line-height: 1.3;
    margin: 0 0 0.25rem;
  }
  .tee-title a {
    color: var(--title);
  }
  .tee-course {
    font-style: italic;
    line-height: 1.45;
  }
  .tee-verified {
    font-size: 0.8125rem;
    line-height: 1.4;
    font-style: italic;
    color: var(--ink-muted);
    margin-top: 0.375rem !important;
  }
  .tee-note {
    font-size: 0.875rem;
    line-height: 1.45;
    margin-top: 0.375rem !important;
  }
  .tee-price {
    grid-area: price;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    align-items: baseline;
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--title);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .tee-price > span + span {
    font-size: 0.875rem;
    font-style: italic;
    color: var(--ink-muted);
  }
  .tee-price-unknown {
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--ink-muted);
  }
  .tee-action {
    grid-area: action;
    padding-top: 0.125rem;
  }
  .tee-action .button {
    min-width: 8.5rem;
  }
  @container (min-width: 680px) {
    .tee-row {
      grid-template-columns: 5rem minmax(0, 1fr) 10rem 9rem;
      grid-template-areas: "date main price action";
      align-items: start;
      gap: 0 1.75rem;
      padding: 1.625rem 0 1.75rem;
    }
    .tee-date {
      padding-right: 1.5rem;
      min-height: 4.5rem;
    }
    .tee-date-big {
      font-size: 2.25rem;
    }
    .tee-title {
      font-size: 1.3125rem;
    }
    .tee-price {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      padding-top: 0.125rem;
    }
    .tee-action .button {
      width: 100%;
    }
  }
</style>
