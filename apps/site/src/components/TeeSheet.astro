---
/**
 * A list of outings as a tee sheet: ruled rows on an alternating turf tint, the
 * date in the left column like a scorecard's hole numbers. Row styles live here
 * as global CSS so the home page's near-you rows (built in the browser) match.
 */
import type { OutingListItem } from "@gof/db/queries";
import type { ListingFilters } from "@gof/shared/filters";
import type { LatLng } from "@gof/shared/places";
import TeeSheetRow from "./TeeSheetRow.astro";
import { isVisible } from "../lib/listing.ts";

interface Props {
  outings: readonly OutingListItem[];
  center?: LatLng | null;
  /** Server-side filters (city and state pages); rows they exclude render hidden. */
  filters?: ListingFilters;
}

const { outings, center = null, filters } = Astro.props;
---

<ul class="tee-sheet">
  {outings.map((o) => <TeeSheetRow outing={o} center={center} hidden={filters ? !isVisible(o, filters, center) : false} />)}
</ul>

<style is:global>
  .tee-sheet {
    list-style: none;
    margin: 0.75rem 0 1.5rem;
    padding: 0;
    border-top: 1.5px solid var(--rule);
  }
  .tee-row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    grid-template-areas:
      "date main"
      "date price"
      "date action";
    gap: 0.375rem 1rem;
    max-width: none;
    padding: 0.875rem 0.75rem 1rem;
    border-bottom: 1.5px solid var(--rule);
  }
  .tee-row:nth-child(even of :not([hidden])) {
    background: var(--surface);
  }
  .tee-row p {
    margin: 0;
  }
  .tee-date {
    grid-area: date;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 1.15;
    color: var(--ink);
  }
  .tee-date-top,
  .tee-date-bottom {
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .tee-date-big {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
  }
  .tee-main {
    grid-area: main;
    min-width: 0;
  }
  .tee-title {
    font-size: 1.125rem;
    line-height: 1.25;
    margin: 0 0 0.25rem;
  }
  .tee-course {
    font-size: 1rem;
    line-height: 1.4;
  }
  .tee-note {
    font-size: 0.875rem;
    line-height: 1.4;
    margin-top: 0.375rem !important;
  }
  .tee-price {
    grid-area: price;
    display: flex;
    flex-direction: column;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .tee-price > span + span {
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .tee-price-unknown {
    font-weight: 400;
    color: var(--ink-muted);
  }
  .tee-action {
    grid-area: action;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
  }
  .tee-action .button {
    min-width: 7.5rem;
  }
  @media (max-width: 719.98px) {
    /* Phones: the date block sits top-left on one line; everything else stacks under it. */
    .tee-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "date" "main" "price" "action";
      padding: 0.75rem 0.5rem 0.875rem;
    }
    .tee-date {
      flex-direction: row;
      align-items: baseline;
      gap: 0.375rem;
      text-align: left;
    }
    .tee-date-big {
      font-size: 1.375rem;
    }
    .tee-price {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 0.5rem;
      align-items: baseline;
    }
  }
  @media (min-width: 720px) {
    .tee-row {
      grid-template-columns: 4.5rem minmax(0, 1fr) 10rem 8.5rem;
      grid-template-areas: "date main price action";
      align-items: start;
      gap: 0 1.25rem;
    }
    .tee-price {
      text-align: right;
      padding-top: 0.125rem;
    }
    .tee-action {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      gap: 0.375rem;
    }
    .tee-action .button {
      min-width: 0;
    }
  }
</style>
