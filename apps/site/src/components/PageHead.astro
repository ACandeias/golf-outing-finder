---
/**
 * The page title block. With a photo: a tall full-bleed photograph under a
 * bottle-green scrim, with the breadcrumbs, the title and the tagline set
 * bottom-left on the page grid. Without one (guides, legal pages, the map): the
 * same block on paper with a short gilt rule. Titles and taglines are text,
 * never HTML.
 */
import Breadcrumbs, { type CrumbLink } from "./Breadcrumbs.astro";
import Photo from "./Photo.astro";
import type { PhotoKey } from "../lib/photos.ts";

interface Props {
  title: string;
  tagline?: string;
  crumbs: CrumbLink[];
  photo?: PhotoKey | null;
  compact?: boolean;
}

const { title, tagline, crumbs, photo = null, compact = false } = Astro.props;
---

<div class:list={["page-head", photo ? "page-head-band" : "page-head-plain", { compact }]}>
  {
    photo && (
      <>
        <Photo photo={photo} kind="band" />
        <div class="scrim" />
      </>
    )
  }
  <div class="page-head-inner">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="page-title">{title}</h1>
    {tagline && <p class="page-tagline">{tagline}</p>}
    {!photo && <span class="ornament" />}
  </div>
</div>
