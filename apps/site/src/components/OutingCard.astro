---
import type { OutingListItem } from "@gof/db/queries";
import { haversineKm, KM_PER_MILE, type LatLng } from "@gof/shared/places";
import { outingView } from "../lib/outing-view.ts";
import { verifiedDate } from "../lib/format.ts";
import { outingPath } from "../lib/urls.ts";

interface Props {
  outing: OutingListItem;
  /** Page centre for the distance filter (city pages). */
  center?: LatLng | null;
  headingLevel?: 2 | 3;
  /** Hidden by the active filters (the browser script can show it again). */
  hidden?: boolean;
}

const { outing: o, center = null, headingLevel = 3, hidden = false } = Astro.props;
const v = outingView(o);
const H = headingLevel === 2 ? "h2" : "h3";
const distanceMiles = center ? haversineKm(center, o.course) / KM_PER_MILE : null;
const registerHref = o.registrationUrl ?? o.canonicalSourceUrl;
---

<article
  class="card"
  hidden={hidden}
  data-outing
  data-course-type={o.course.courseType}
  data-outing-type={o.outingType}
  data-single={o.singlePriceCents ?? ""}
  data-date={o.startDate ?? ""}
  data-format={o.format ?? ""}
  data-distance={distanceMiles === null ? "" : distanceMiles.toFixed(1)}
>
  <H class="card-title"><a href={outingPath(o.slug)}>{o.title}</a></H>
  <p class="card-course">
    <strong>{o.course.name}</strong>, {v.place}
  </p>
  <p class="card-when">
    {v.when}{v.time && <span>, {v.time}</span>}
  </p>
  <p class="badges">
    <span class="badge type"><span class="visually-hidden">Course type: </span>{v.courseTypeLabel}</span>
    <span class="badge"><span class="visually-hidden">Outing type: </span>{o.label}</span>
    {o.status === "waitlist" && <span class="badge">Waitlist</span>}
    {o.status === "sold_out" && <span class="badge">Sold out</span>}
    {o.status === "cancelled" && <span class="badge">Cancelled</span>}
  </p>
  <p class="card-price">{v.price}</p>
  {v.includes && <p class="small">{v.includes}</p>}
  {o.audienceNote && <p class="small muted">{o.audienceNote}</p>}
  <p class="card-actions">
    {
      !v.isExpected && !v.isPast && o.status !== "cancelled" ? (
        <a class="button" href={registerHref} rel="nofollow noopener" target="_blank">
          {o.registrationUrl ? "Register" : "See site"}
          <span class="visually-hidden"> for {o.title} (opens the organizer's site)</span>
        </a>
      ) : (
        <a class="button secondary" href={outingPath(o.slug)}>
          Details<span class="visually-hidden"> for {o.title}</span>
        </a>
      )
    }
    <span class="small muted">Last verified {verifiedDate(o.lastVerified)}</span>
  </p>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    background: var(--bg);
  }
  .card p {
    margin: 0.25rem 0;
  }
  .card-title a {
    text-decoration: none;
  }
  .card-title a:hover {
    text-decoration: underline;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .card-price {
    font-weight: 600;
  }
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem !important;
  }
</style>
