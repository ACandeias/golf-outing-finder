---
import {
  COURSE_TYPE_FILTERS,
  COURSE_TYPE_FILTER_LABELS,
  DISTANCE_MILES,
  FORMAT_FILTERS,
  type ListingFilters,
} from "@gof/shared/filters";
import { FORMAT_LABELS } from "../lib/format.ts";

interface Props {
  filters: ListingFilters;
  /** The unfiltered page path (form action and "Clear filters"). */
  action: string;
  showDistance?: boolean;
  /** "from Mamaroneck" */
  distanceFrom?: string;
  total: number;
  shown: number;
}

const { filters: f, action, showDistance = false, distanceFrom = "", total, shown } = Astro.props;
// Collapsed until a filter is in use, so the tee sheet comes first.
const active =
  f.courseTypes.length > 0 ||
  f.charityOnly ||
  f.singlesWelcome ||
  f.maxPriceCents !== null ||
  f.from !== null ||
  f.to !== null ||
  f.distanceMiles !== null ||
  f.format !== null;
---

<details class="filters" open={active}>
  <summary>Filter outings</summary>
  <form method="get" action={action} data-filter-form>
    <fieldset>
      <legend>Course type</legend>
      {
        COURSE_TYPE_FILTERS.map((t) => (
          <label class="check">
            <input type="checkbox" name="course_type" value={t} checked={f.courseTypes.includes(t)} />
            {COURSE_TYPE_FILTER_LABELS[t]}
          </label>
        ))
      }
    </fieldset>
    <div class="row">
      <label class="check">
        <input type="checkbox" name="charity" value="1" checked={f.charityOnly} />
        Charity outings only
      </label>
      <label class="check">
        <input type="checkbox" name="singles" value="1" checked={f.singlesWelcome} />
        Singles welcome (a single price is listed)
      </label>
    </div>
    <div class="row">
      <label>
        Max price per player ($)
        <input
          type="number"
          name="max_price"
          min="0"
          max="25000"
          step="1"
          inputmode="numeric"
          value={f.maxPriceCents === null ? "" : String(Math.floor(f.maxPriceCents / 100))}
        />
      </label>
      <label>
        From
        <input type="date" name="from" value={f.from ?? ""} />
      </label>
      <label>
        To
        <input type="date" name="to" value={f.to ?? ""} />
      </label>
      {
        showDistance && (
          <label>
            Distance {distanceFrom}
            <select name="distance">
              <option value="">Any distance</option>
              {DISTANCE_MILES.map((d) => (
                <option value={String(d)} selected={f.distanceMiles === d}>
                  Within {d} miles
                </option>
              ))}
            </select>
          </label>
        )
      }
      <label>
        Format
        <select name="format">
          <option value="">Any format</option>
          {
            FORMAT_FILTERS.map((x) => (
              <option value={x} selected={f.format === x}>
                {FORMAT_LABELS[x]}
              </option>
            ))
          }
        </select>
      </label>
    </div>
    <div class="row actions">
      <button class="button" type="submit">Apply filters</button>
      <a class="clear" href={action}>Clear filters</a>
    </div>
  </form>
</details>
<p class="count small muted" aria-live="polite" data-filter-count>
  {shown === total ? `${total} ${total === 1 ? "outing" : "outings"}` : `Showing ${shown} of ${total} outings`}
</p>

<style>
  .filters {
    background: var(--surface);
    border-top: 1.5px solid var(--rule);
    border-bottom: 1.5px solid var(--rule);
    padding: 0 1rem;
    margin: 1.25rem 0 0.5rem;
    font-family: var(--sans);
    font-variant-numeric: lining-nums tabular-nums;
  }
  /* The one animated interaction: the panel's height as it opens and closes. */
  @supports (interpolate-size: allow-keywords) {
    .filters {
      interpolate-size: allow-keywords;
    }
    .filters::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 160ms ease,
        content-visibility 160ms allow-discrete;
    }
    .filters[open]::details-content {
      block-size: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .filters::details-content {
      transition: none;
    }
  }
  summary {
    cursor: pointer;
    font-size: 1.125rem;
    font-weight: 600;
    padding: 0.625rem 0;
    min-height: 44px;
  }
  form {
    padding-bottom: 0.75rem;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0.25rem 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  legend {
    font-weight: 600;
    margin-bottom: 0.125rem;
    padding: 0;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0.75rem 0;
    align-items: end;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 1rem;
  }
  label.check {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    min-height: 36px;
  }
  input[type="number"],
  input[type="date"],
  select {
    font: inherit;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    background: var(--page);
    color: var(--ink);
    min-height: 44px;
  }
  input[type="number"] {
    width: 8rem;
  }
  input[type="checkbox"] {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--fairway);
  }
  .actions {
    align-items: center;
    margin-bottom: 0;
  }
  .clear {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .count {
    margin: 0.5rem 0 0;
  }
</style>

<script>
  import { initFilters } from "../scripts/filters.ts";
  initFilters();
</script>
