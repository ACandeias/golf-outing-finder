---
/**
 * Access opportunities (auction lots, member-for-a-day, stay-and-play, ...) as
 * a ruled list. Text only; the link goes to the listing on its own platform.
 */
import type { AccessListItem } from "@gof/db/access";
import { deadlineLabel } from "../lib/access-timeline.ts";
import { accessView, safeHttpUrl } from "../lib/access-view.ts";
import { placeText } from "../lib/format.ts";
import { coursePath } from "../lib/urls.ts";

interface Props {
  items: readonly AccessListItem[];
  /** Name the course on each row (home and /top-courses; not on a course page). */
  showCourse?: boolean;
  /** Show a countdown on open and upcoming rows, counted from each item's own day at its course. */
  countdown?: boolean;
  /** Heading level for each row's title: 3 under an h2 (the default), 4 under an h3. */
  headingLevel?: 3 | 4;
}
const { items, showCourse = false, countdown = false, headingLevel = 3 } = Astro.props;
const Title = `h${headingLevel}` as "h3" | "h4";
---

<ul class="access-list">
  {
    items.map((it) => {
      const v = accessView(it);
      const href = safeHttpUrl(it.link);
      const deadline = countdown ? deadlineLabel(it, it.localToday) : null;
      return (
        <li class="access-row" data-access data-kind={it.kind} data-status={it.status}>
          <p class="access-meta">
            <span>{v.kindLabel}</span>
            <span class:list={["access-status", `access-${it.status}`]}>{v.statusLabel}</span>
          </p>
          <Title class="access-title">{it.title}</Title>
          {showCourse && (
            <p class="access-course">
              <a href={coursePath(it.course.slug)}>{it.course.name}</a>, {placeText(it.course.city, it.course.state)}
            </p>
          )}
          {deadline && (
            <p class="access-deadline" data-deadline>
              {deadline}
            </p>
          )}
          <p class="access-when">
            {v.when}
            {v.party && <span>. {v.party}</span>}
          </p>
          {v.who && <p class="access-who">{v.who}</p>}
          <p class="access-price">{v.price}</p>
          {href && (
            <p class="access-action">
              <a class="button secondary" href={href} rel="nofollow noopener" target="_blank">
                View on {it.platform}
                <span class="visually-hidden"> (opens {it.platform})</span>
              </a>
            </p>
          )}
          <p class="access-source">{v.source}</p>
        </li>
      );
    })
  }
</ul>

<style>
  .access-list {
    list-style: none;
    margin: 0.75rem 0 1.75rem;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .access-row {
    padding: 1.125rem 0 1.25rem;
    border-bottom: 1px solid var(--rule);
    max-width: none;
  }
  .access-row p {
    margin: 0;
  }
  .access-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    font-family: var(--display);
    font-size: 0.75rem;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .access-status {
    border-left: 1px solid var(--rule-strong);
    padding-left: 0.75rem;
  }
  .access-open,
  .access-upcoming {
    color: var(--fairway);
  }
  .access-title {
    font-family: var(--serif);
    font-size: 1.1875rem;
    font-weight: 400;
    text-wrap: pretty;
    line-height: 1.3;
    margin: 0.375rem 0 0.25rem;
    color: var(--title);
  }
  .access-course {
    font-style: italic;
  }
  .access-deadline {
    font-weight: 600;
    color: var(--fairway);
  }
  .access-when,
  .access-who {
    line-height: 1.45;
  }
  .access-who {
    color: var(--ink-muted);
  }
  .access-price {
    margin-top: 0.375rem !important;
    font-size: 1.0625rem;
    color: var(--title);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .access-action {
    margin-top: 0.625rem !important;
  }
  .access-source {
    margin-top: 0.5rem !important;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--ink-muted);
  }
</style>
