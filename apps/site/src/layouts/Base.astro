---
import { buildBreadcrumbJsonLd } from "@gof/shared/jsonld";
import Breadcrumbs, { type CrumbLink } from "../components/Breadcrumbs.astro";
import JsonLd from "../components/JsonLd.astro";
import AdsRuntime from "../components/AdsRuntime.astro";
import { siteAdsConfig } from "../lib/ads-env.ts";
import { absoluteUrl, canonicalPath } from "../lib/urls.ts";
import { GUIDES_PATH, hasGuides } from "../lib/guides.ts";

interface Props {
  title: string;
  description: string;
  /** Canonical path (the unfiltered URL). Defaults to the request path. */
  path?: string;
  noindex?: boolean;
  /** Breadcrumbs after "Home"; the last one is this page. */
  crumbs?: CrumbLink[];
  jsonLd?: unknown[];
  /** Full-bleed main area (the map page). */
  wide?: boolean;
}

const { title, description, noindex = false, crumbs = [], jsonLd = [], wide = false } = Astro.props;
const path = canonicalPath(Astro.props.path ?? Astro.url.pathname);
const canonical = absoluteUrl(path, Astro);
const allCrumbs: CrumbLink[] = [{ name: "Home", path: "/" }, ...crumbs];
const breadcrumbLd = buildBreadcrumbJsonLd(
  allCrumbs.map((c, i) => ({ name: c.name, url: absoluteUrl(i === allCrumbs.length - 1 ? path : (c.path ?? path), Astro) })),
);
const year = new Date().getUTCFullYear();
// Link to /guides only when this build renders a guide (never to drafts in production).
const showGuides = await hasGuides();
// Consent, analytics and ads run on server-rendered pages only: prerendered pages
// are built before any Worker var exists (SPEC.md 9.5; see AdsRuntime.astro).
const ads = Astro.isPrerendered ? null : siteAdsConfig();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1F4D3A" />
    <link rel="preload" href="/fonts/libre-caslon-text-v5-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/libre-caslon-text-v5-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-narrow-v35-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <JsonLd data={breadcrumbLd} />
    {jsonLd.map((d) => <JsonLd data={d} />)}
    {ads?.runtime && <AdsRuntime config={ads} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/">
          <svg class="mark" width="14" height="22" viewBox="0 0 14 22" aria-hidden="true" focusable="false">
            <path d="M2 1.5v19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" fill="none" />
            <path d="M2.9 1.8 13 5.9 2.9 10Z" fill="currentColor" />
          </svg>
          Golf Outing Finder
        </a>
        <nav aria-label="Main">
          <ul class="nav">
            <li><a href="/golf-outings">Browse outings</a></li>
            <li><a href="/map">Map</a></li>
            {showGuides && <li><a href={GUIDES_PATH}>Guides</a></li>}
            <li><a href="/about">About</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class={wide ? "wide" : "wrap"}>
      {wide ? <div class="wrap"><Breadcrumbs crumbs={allCrumbs} /></div> : <Breadcrumbs crumbs={allCrumbs} />}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Site">
          <ul class="footer-links">
            <li><a href="/about">About</a></li>
            {showGuides && <li><a href={GUIDES_PATH}>Guides</a></li>}
            <li><a href="/corrections">Corrections</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
            <li><a href="/bot">Our crawler</a></li>
            <li><a href="/listed">Listed here?</a></li>
            {
              ads?.enabled && ads.provider === "adsense" && (
                <li data-privacy-choices hidden>
                  <button type="button" class="link-button">Privacy choices</button>
                </li>
              )
            }
          </ul>
        </nav>
        <p class="small footer-note">
          Golf Outing Finder lists outings anyone can pay to enter. Every listing links to its source; check details with the
          organizer before you pay. © {year} Golf Outing Finder.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Self-hosted, latin subset, OFL (public/fonts/LICENSE.txt). */
  @font-face {
    font-family: "Libre Caslon Text";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/libre-caslon-text-v5-400-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Libre Caslon Text";
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/libre-caslon-text-v5-400italic-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Libre Caslon Text";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/libre-caslon-text-v5-700-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  /* Archivo Narrow is a variable font: one file covers 400 and 600. */
  @font-face {
    font-family: "Archivo Narrow";
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url("/fonts/archivo-narrow-v35-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  /*
   * Metric-matched fallbacks so the swap doesn't move anything (CLS 0). Values come
   * from each font's hhea/OS2 tables: size-adjust matches average glyph width, and
   * the overrides are the web font's ascent and descent divided by size-adjust.
   */
  @font-face {
    font-family: "Caslon fallback";
    src: local("Georgia");
    size-adjust: 108.3%;
    ascent-override: 89.6%;
    descent-override: 24%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Caslon fallback 2";
    src: local("Times New Roman");
    size-adjust: 115.3%;
    ascent-override: 84.1%;
    descent-override: 22.6%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Archivo Narrow fallback";
    src: local("Arial Narrow");
    size-adjust: 100.1%;
    ascent-override: 103.4%;
    descent-override: 31.2%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Archivo Narrow fallback 2";
    src: local("Arial");
    size-adjust: 82.1%;
    ascent-override: 126.1%;
    descent-override: 38%;
    line-gap-override: 0%;
  }

  :root {
    color-scheme: light;
    /* Clubhouse tokens (design/README.md). */
    --page: #faf8f3;
    --surface: #eef2ec;
    --fairway: #1f4d3a;
    --ink: #1b2a22;
    --ink-muted: #4e5b54;
    --brass: #9a7b2e;
    --flag: #b4332e;
    --band: #1f4d3a;
    --band-fg: #ede9df;
    --plaque: #1f4d3a;
    --plaque-fg: #faf8f3;
    --link: var(--fairway);
    --rule: var(--fairway);
    --focus: var(--fairway);
    --radius: 2px;
    --serif: "Libre Caslon Text", "Caslon fallback", "Caslon fallback 2", Georgia, serif;
    --sans: "Archivo Narrow", "Archivo Narrow fallback", "Archivo Narrow fallback 2", "Arial Narrow", sans-serif;
    /* Older names, still used by a few pages. */
    --fg: var(--ink);
    --bg: var(--page);
    --muted: var(--ink-muted);
    --border: var(--ink-muted);
    --accent: var(--plaque);
    --accent-fg: var(--plaque-fg);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --page: #10201a;
      --surface: #17291f;
      --fairway: #8ccba6;
      --ink: #ede9df;
      --ink-muted: #b8c0b6;
      --flag: #e0706a;
      --band: #1f4d3a;
      --band-fg: #ede9df;
      --plaque: #2e6b50;
      --plaque-fg: #ede9df;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }
  body {
    margin: 0;
    font-family: var(--serif);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
    background: var(--page);
  }
  a {
    color: var(--link);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  /* Links inside running text keep an underline so they don't rely on color alone. */
  p a:not(.button),
  dd a,
  main ul:not([class]) a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  :focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  main:focus {
    outline: none;
  }
  .wrap {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 16px;
  }
  main.wrap {
    padding-top: 1rem;
    padding-bottom: 3rem;
    min-height: 60vh;
  }
  main.wide {
    padding: 0;
  }
  h1,
  h2,
  h3 {
    font-family: var(--serif);
    font-weight: 700;
    line-height: 1.1;
    text-wrap: balance;
  }
  h1 {
    font-size: 2rem;
    margin: 1rem 0 0.75rem;
    max-width: 30ch;
  }
  @media (min-width: 720px) {
    h1 {
      font-size: 2.5rem;
    }
  }
  h2 {
    font-size: 1.375rem;
    margin: 2.5rem 0 0.75rem;
  }
  h3 {
    font-size: 1.125rem;
    margin: 0 0 0.25rem;
  }
  p,
  li,
  dd {
    max-width: 70ch;
  }
  .lead {
    font-size: 1.125rem;
  }
  .muted {
    color: var(--ink-muted);
  }
  .small {
    font-size: 0.875rem;
  }
  /* Archivo Narrow: every piece of data and chrome. */
  .data,
  .small,
  .crumbs,
  .nav,
  .footer-links,
  .button,
  .label,
  label,
  legend,
  summary,
  button,
  input,
  select,
  table {
    font-family: var(--sans);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .skip {
    position: absolute;
    left: 8px;
    top: -48px;
    padding: 8px 12px;
    background: var(--plaque);
    color: var(--plaque-fg);
    font-family: var(--sans);
    z-index: 10;
    border-radius: var(--radius);
  }
  .skip:focus {
    top: 8px;
  }

  /* Header and footer: fairway band, pale stone type, brass hairline. */
  .site-header,
  .site-footer {
    --link: var(--band-fg);
    --focus: var(--band-fg);
    background: var(--band);
    color: var(--band-fg);
  }
  .site-header {
    border-bottom: 2px solid var(--brass);
  }
  .header-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--band-fg);
    padding: 0.5rem 0;
  }
  .brand .mark {
    color: var(--brass);
    flex: none;
  }
  .nav,
  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
  }
  .nav a,
  .footer-links a {
    display: inline-block;
    padding: 0.625rem 0;
    text-decoration: none;
  }
  .nav a:hover,
  .footer-links a:hover {
    text-decoration: underline;
  }
  .site-footer {
    padding: 1.5rem 0 2rem;
  }
  /* "Privacy choices" reopens the consent message: a button that looks like the footer links. */
  .link-button {
    display: inline-block;
    padding: 0.625rem 0;
    border: 0;
    background: none;
    color: var(--link);
    font-size: 1rem;
    line-height: inherit;
    cursor: pointer;
  }
  .link-button:hover {
    text-decoration: underline;
  }
  .footer-note {
    margin: 0.75rem 0 0;
    font-family: var(--sans);
  }

  /* Breadcrumbs. */
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .crumbs li {
    max-width: none;
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 0.25rem;
  }

  /* The Register plaque and the outlined secondary button. */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1.125rem;
    border: 1.5px solid var(--plaque);
    border-radius: var(--radius);
    background: var(--plaque);
    color: var(--plaque-fg);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }
  .button:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .button.secondary {
    background: transparent;
    border-color: var(--fairway);
    color: var(--fairway);
  }

  /* Labels: course type, outing type, status. Outlined, never pills. */
  .labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.375rem 0 0;
  }
  .label {
    display: inline-block;
    padding: 0 0.375rem;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .label.alert {
    border-color: var(--flag);
    color: var(--flag);
  }

  /* Notes: a left-ruled aside. */
  .note {
    margin: 1rem 0;
    padding: 0.125rem 0 0.125rem 1rem;
    border-left: 3px solid var(--rule);
  }
  .note > p {
    margin: 0.25rem 0;
  }
  .note.alert {
    border-left-color: var(--flag);
    color: var(--flag);
  }

  /* Scorecard: a ruled definition list (outing details, course facts). */
  .scorecard {
    margin: 0 0 1rem;
    border-top: 1.5px solid var(--rule);
  }
  .scorecard > div {
    display: grid;
    grid-template-columns: minmax(7rem, 10rem) minmax(0, 1fr);
    gap: 0 1rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .scorecard > div:nth-child(even) {
    background: var(--surface);
  }
  .scorecard dt {
    font-family: var(--sans);
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .scorecard dd {
    margin: 0;
    font-variant-numeric: lining-nums;
  }
  .scorecard dd.num {
    font-family: var(--sans);
    font-variant-numeric: lining-nums tabular-nums;
  }
  @media (max-width: 479.98px) {
    .scorecard > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Ruled tables. */
  table {
    border-collapse: collapse;
  }
  .ruled {
    width: 100%;
    max-width: 32rem;
    border-top: 1.5px solid var(--rule);
    border-bottom: 1.5px solid var(--rule);
  }
  .ruled th,
  .ruled td {
    text-align: left;
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .ruled thead th {
    font-weight: 600;
  }
  .ruled tbody th {
    font-weight: 400;
  }
  .ruled td {
    text-align: right;
  }
  .ruled thead th:not(:first-child) {
    text-align: right;
  }
  .ruled tbody tr:nth-child(even) {
    background: var(--surface);
  }
  .grid-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: 0 1.5rem;
    font-family: var(--sans);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .grid-links a {
    display: inline-block;
    padding: 0.3rem 0;
    text-decoration: none;
  }
  .grid-links a:hover {
    text-decoration: underline;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  [hidden] {
    display: none !important;
  }
</style>
