---
import { buildBreadcrumbJsonLd } from "@gof/shared/jsonld";
import { OSM_ATTRIBUTION_TEXT } from "@gof/shared/places";
import type { CrumbLink } from "../components/Breadcrumbs.astro";
import Crest from "../components/Crest.astro";
import JsonLd from "../components/JsonLd.astro";
import PageHead from "../components/PageHead.astro";
import AdsRuntime from "../components/AdsRuntime.astro";
import { siteAdsConfig } from "../lib/ads-env.ts";
import { siteYear } from "../lib/clock.ts";
import { absoluteUrl, canonicalPath } from "../lib/urls.ts";
import { GUIDES_PATH, hasGuides } from "../lib/guides.ts";
import type { PhotoKey } from "../lib/photos.ts";

interface Props {
  title: string;
  description: string;
  /** Canonical path (the unfiltered URL). Defaults to the request path. */
  path?: string;
  noindex?: boolean;
  /** Breadcrumbs after "Home"; the last one is this page. */
  crumbs?: CrumbLink[];
  jsonLd?: unknown[];
  /** Full-bleed main area (the map page). */
  wide?: boolean;
  /** The page's h1, set in the page head. Omit when the page renders its own (home). */
  heading?: string;
  /** An italic line under the heading. */
  tagline?: string;
  /** The page head's band photo; null for the plain linen header. */
  photo?: PhotoKey | null;
  /** The home page: the header floats over the hero and there is no page head. */
  home?: boolean;
}

const {
  title,
  description,
  noindex = false,
  crumbs = [],
  jsonLd = [],
  wide = false,
  heading,
  tagline,
  photo = null,
  home = false,
} = Astro.props;
const path = canonicalPath(Astro.props.path ?? Astro.url.pathname);
const canonical = absoluteUrl(path, Astro);
const allCrumbs: CrumbLink[] = [{ name: "Home", path: "/" }, ...crumbs];
const breadcrumbLd = buildBreadcrumbJsonLd(
  allCrumbs.map((c, i) => ({ name: c.name, url: absoluteUrl(i === allCrumbs.length - 1 ? path : (c.path ?? path), Astro) })),
);
// The site clock, so a pinned SITE_NOW and the footer agree (prerendered pages keep their build year).
const year = siteYear();
// Link to /guides only when this build renders a guide (never to drafts in production).
const showGuides = await hasGuides();
// Consent, analytics and ads run on server-rendered pages only: prerendered pages
// are built before any Worker var exists (SPEC.md 9.5; see AdsRuntime.astro).
const ads = Astro.isPrerendered ? null : siteAdsConfig();
const navItems = [
  { href: "/golf-outings", label: "Browse outings", match: ["/golf-outings", "/charity-golf-tournaments", "/outings", "/courses", "/organizers"] },
  { href: "/map", label: "Map", match: ["/map"] },
  ...(showGuides ? [{ href: GUIDES_PATH, label: "Guides", match: [GUIDES_PATH] }] : []),
  { href: "/about", label: "About", match: ["/about"] },
];
const current = (match: string[]) => match.some((m) => path === m || path.startsWith(`${m}/`));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#14291F" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1E16" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/cormorant-garamond-v21-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/libre-caslon-text-v5-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/libre-caslon-text-v5-400italic-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <JsonLd data={breadcrumbLd} />
    {jsonLd.map((d) => <JsonLd data={d} />)}
    {ads?.runtime && <AdsRuntime config={ads} />}
    <!-- Controls that only work with JavaScript (near-you, the city map toggle) are not shown without it. -->
    <noscript><style>[data-needs-js] { display: none !important; }</style></noscript>
  </head>
  <body class:list={{ "is-home": home }}>
    <a class="skip" href="#main">Skip to main content</a>
    <header class:list={["site-header", home ? "is-overlay" : "is-solid"]}>
      <div class="header-row">
        <a class="brand" href="/">
          <Crest size={36} />
          <span class="brand-name">Golf Outing Finder</span>
        </a>
        <nav aria-label="Main">
          <ul class="nav">
            {
              navItems.map((n) => (
                <li>
                  <a href={n.href} aria-current={current(n.match) ? "page" : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={{ wide }}>
      {heading && <PageHead title={heading} tagline={tagline} crumbs={allCrumbs} photo={photo} compact={wide} />}
      {home ? <slot /> : <div class:list={["page-body", { wrap: !wide }]}><slot /></div>}
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-about">
          <a class="footer-brand" href="/">
            <Crest size={44} />
            <span class="brand-name">Golf Outing Finder</span>
          </a>
          <p class="footer-note">
            Golf Outing Finder lists outings anyone can pay to enter. Every listing links to its source; check details with the
            organizer before you pay.
          </p>
        </div>
        <nav aria-label="Site" class="footer-nav">
          <div>
            <h2 class="footer-heading">Find an outing</h2>
            <ul class="footer-links">
              <li><a href="/golf-outings">Outings by state</a></li>
              <li><a href="/map">Map of outings</a></li>
              {showGuides && <li><a href={GUIDES_PATH}>Guides</a></li>}
              <li><a href="/listed">Listed here?</a></li>
            </ul>
          </div>
          <div>
            <h2 class="footer-heading">About this site</h2>
            <ul class="footer-links">
              <li><a href="/about">About</a></li>
              <li><a href="/corrections">Corrections</a></li>
              <li><a href="/bot">Our crawler</a></li>
              <li><a href="/privacy">Privacy</a></li>
              <li><a href="/terms">Terms</a></li>
              {
                ads?.enabled && ads.provider === "adsense" && (
                  <li data-privacy-choices hidden>
                    <button type="button" class="link-button">Privacy choices</button>
                  </li>
                )
              }
            </ul>
          </div>
        </nav>
        <p class="footer-legal">
          Course data {OSM_ATTRIBUTION_TEXT}. Photographs from Unsplash and Pexels, <a href="/about#photo-credits">credited here</a>.
          © {year} Golf Outing Finder.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Self-hosted, latin subset, OFL (public/fonts/LICENSE.txt). */
  @font-face {
    font-family: "Marcellus";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/marcellus-v14-400-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Libre Caslon Text";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/libre-caslon-text-v5-400-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Libre Caslon Text";
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/libre-caslon-text-v5-400italic-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  /* Cormorant Garamond (variable weight): page titles and headings, set large in sentence case. */
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url("/fonts/cormorant-garamond-v21-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: italic;
    font-weight: 300 700;
    font-display: swap;
    src: url("/fonts/cormorant-garamond-v21-italic-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  /* Bold appears only in <strong> inside prose; not preloaded. */
  @font-face {
    font-family: "Libre Caslon Text";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/libre-caslon-text-v5-700-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  /*
   * Metric-matched fallbacks so the swap doesn't move anything. size-adjust matches
   * average glyph width; the overrides are the web font's ascent and descent divided
   * by size-adjust (Caslon from its hhea/OS2 tables; Marcellus measured in Chromium
   * against Georgia and Times New Roman over capitals, figures and lowercase).
   */
  @font-face {
    font-family: "Caslon fallback";
    src: local("Georgia");
    size-adjust: 108.3%;
    ascent-override: 89.6%;
    descent-override: 24%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Caslon fallback 2";
    src: local("Times New Roman");
    size-adjust: 115.3%;
    ascent-override: 84.1%;
    descent-override: 22.6%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Cormorant fallback";
    src: local("Georgia");
    size-adjust: 84%;
    ascent-override: 110%;
    descent-override: 34%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Cormorant fallback 2";
    src: local("Times New Roman");
    size-adjust: 91%;
    ascent-override: 101.5%;
    descent-override: 31.5%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Marcellus fallback";
    src: local("Georgia");
    size-adjust: 96.7%;
    ascent-override: 100.3%;
    descent-override: 29%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: "Marcellus fallback 2";
    src: local("Times New Roman");
    size-adjust: 101.1%;
    ascent-override: 95.9%;
    descent-override: 27.7%;
    line-gap-override: 0%;
  }

  /* The Clubhouse tokens (design/README.md). */
  :root {
    color-scheme: light;
    --bottle: #14291f;
    --page: #fbfaf6;
    --surface: #f1eee4;
    --fairway: #2c5640;
    --ink: #1c241f;
    --ink-muted: #545e57;
    --title: #14291f;
    --gilt: #a88a52;
    --claret: #7a2430;
    --rule: rgb(168 138 82 / 0.38);
    --rule-strong: rgb(168 138 82 / 0.8);
    --link: var(--fairway);
    --focus: var(--fairway);
    --btn: var(--fairway);
    --btn-hover: #14291f;
    --btn-fg: #fbfaf6;
    /* Header, footer and photo bands: always dark, in both schemes. */
    --band: #14291f;
    --band-fg: #fbfaf6;
    --band-muted: #c9d2cb;
    --band-rule: rgb(168 138 82 / 0.6);
    --display: "Cormorant Garamond", "Cormorant fallback", "Cormorant fallback 2", Georgia, serif;
    --label: "Marcellus", "Marcellus fallback", "Marcellus fallback 2", Georgia, serif;
    --serif: "Libre Caslon Text", "Caslon fallback", "Caslon fallback 2", Georgia, serif;
    --track: 0.16em;
    /* One spacing scale and one page width for every template. */
    --gutter: 20px;
    --wrap: 1180px;
    --measure: 44rem;
    --space-section: clamp(3.5rem, 8vw, 6.5rem);
  }
  @media (min-width: 720px) {
    :root {
      --gutter: 40px;
    }
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --page: #14291f;
      --surface: #1a3327;
      --fairway: #a8cdb5;
      --ink: #eef0ea;
      --ink-muted: #b4bfb7;
      --title: #f4f4ef;
      --gilt: #c9ac74;
      --claret: #e9a3ab;
      --rule: rgb(201 172 116 / 0.3);
      --rule-strong: rgb(201 172 116 / 0.7);
      --btn: #a8cdb5;
      --btn-hover: #c4e0cd;
      --btn-fg: #14291f;
      --band: #0e1e16;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }
  body {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    font-variant-numeric: lining-nums;
    color: var(--ink);
    background: var(--page);
  }
  a {
    color: var(--link);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  /* Links inside running text keep an underline so they don't rely on color alone. */
  p a:not(.button),
  dd a,
  main ul:not([class]) a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule-strong);
  }
  p a:not(.button):hover,
  dd a:hover,
  main ul:not([class]) a:hover {
    text-decoration-color: currentColor;
  }
  :focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  main:focus {
    outline: none;
  }
  .wrap {
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  main {
    display: block;
    min-height: 60vh;
  }
  .page-body.wrap {
    padding-top: clamp(2.25rem, 5vw, 3.75rem);
    padding-bottom: var(--space-section);
  }
  /* Reading pages (guides, legal) under a plain header: one calm measure. */
  .page-head-plain + .page-body.wrap {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
  h1,
  h2,
  h3 {
    color: var(--title);
    font-weight: 500;
    line-height: 1.12;
    text-wrap: balance;
  }
  h1 {
    font-family: var(--display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.005em;
    margin: 1rem 0 0.75rem;
  }
  /* Section headings: large Cormorant with a short gilt rule above, like a chapter opening. */
  h2 {
    font-family: var(--display);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    margin: var(--space-section) 0 1.25rem;
  }
  h2::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-bottom: 1.125rem;
    background: var(--gilt);
  }
  .page-body > :first-child,
  .page-body > section:first-child > h2:first-child {
    margin-top: 0;
  }
  h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.1875rem;
    line-height: 1.3;
    margin: 0 0 0.25rem;
    text-wrap: pretty;
  }
  p,
  li,
  dd {
    max-width: 70ch;
  }
  strong {
    font-weight: 700;
  }
  .lead {
    font-size: clamp(1.1875rem, 2vw, 1.375rem);
    line-height: 1.6;
    max-width: 46rem;
  }
  .muted {
    color: var(--ink-muted);
  }
  .small {
    font-size: 0.875rem;
  }
  .num {
    font-variant-numeric: lining-nums tabular-nums;
  }
  .skip {
    position: absolute;
    left: 8px;
    top: -60px;
    padding: 10px 14px;
    background: var(--band);
    color: var(--band-fg);
    z-index: 20;
  }
  .skip:focus {
    top: 8px;
    outline-color: var(--band-fg);
  }

  /* Tracked capitals in Marcellus: the wordmark, nav, small headings and buttons, and nothing else. */
  .brand-name,
  .nav a,
  .footer-heading,
  .button {
    font-family: var(--label);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--track);
  }

  /* Header: crest and wordmark left, nav right, on bottle green; on the home page it floats over the photo. */
  .site-header {
    --link: var(--band-fg);
    --focus: var(--band-fg);
    color: var(--band-fg);
  }
  .site-header.is-solid {
    background: var(--band);
  }
  .site-header.is-overlay {
    position: absolute;
    inset: 0 0 auto;
    z-index: 5;
    background: linear-gradient(180deg, rgb(14 30 22 / 0.55), rgb(14 30 22 / 0));
  }
  .header-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0.875rem var(--gutter) 0.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--band-fg);
    padding: 0.25rem 0;
    text-decoration: none;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand .crest {
    color: var(--gilt);
    flex: none;
  }
  .is-overlay .brand .crest {
    color: var(--band-fg);
  }
  .brand-name {
    font-size: 0.9375rem;
    letter-spacing: 0.2em;
  }
  .nav,
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1.5rem;
  }
  .nav li,
  .footer-links li {
    max-width: none;
  }
  .nav a {
    display: inline-block;
    padding: 0.875rem 0 0.75rem;
    font-size: 0.75rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .nav a:hover,
  .nav a[aria-current="page"] {
    text-decoration: none;
    border-bottom-color: var(--gilt);
  }
  @media (max-width: 380px) {
    .nav {
      gap: 0 1.125rem;
    }
    .nav a {
      letter-spacing: 0.12em;
    }
  }
  @media (min-width: 900px) {
    .header-row {
      flex-direction: row;
      justify-content: space-between;
      min-height: 84px;
      padding-top: 0;
      padding-bottom: 0;
    }
    .nav {
      gap: 0 2.75rem;
    }
    .nav a {
      font-size: 0.8125rem;
    }
  }
  .is-overlay .nav a,
  .is-overlay .brand-name {
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.4);
  }

  /*
   * Page head. With a photo: a tall full-bleed photograph, darkened towards the
   * foot, with the breadcrumbs, title and tagline set bottom-left on the page
   * grid. Without one (guides, legal pages, the map): the same block on paper.
   */
  .page-head {
    position: relative;
  }
  .page-head-band {
    --link: var(--band-fg);
    --focus: var(--band-fg);
    display: flex;
    align-items: flex-end;
    min-height: 300px;
    padding: 4.5rem 0 2.25rem;
    color: var(--band-fg);
    background: var(--band);
    overflow: hidden;
    isolation: isolate;
  }
  @media (min-width: 720px) {
    .page-head-band {
      min-height: 420px;
      padding: 6rem 0 3.25rem;
    }
  }
  .photo,
  .photo img,
  .scrim {
    position: absolute;
    inset: 0;
  }
  .photo {
    z-index: -2;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Bottle green, deepest at the foot where the title sits: 4.5:1 for small text over any of the photos. */
  .scrim {
    z-index: -1;
    background: linear-gradient(180deg, rgb(20 41 31 / 0.5), rgb(20 41 31 / 0.42) 30%, rgb(20 41 31 / 0.72) 68%, rgb(20 41 31 / 0.9));
  }
  .page-head-inner {
    position: relative;
    width: 100%;
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .page-title {
    margin: 0.625rem 0 0;
    max-width: 22ch;
    font-size: clamp(2.375rem, 6vw, 4.25rem);
    line-height: 1.04;
  }
  .page-head-band .page-title {
    color: var(--band-fg);
    text-shadow: 0 1px 18px rgb(0 0 0 / 0.3);
  }
  .page-tagline {
