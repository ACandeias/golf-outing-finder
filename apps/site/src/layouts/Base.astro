---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex } = Astro.props;
const siteUrl = Astro.site?.href ?? Astro.locals.runtime?.env?.PUBLIC_SITE_URL ?? "";
const canonicalHref = canonical ?? new URL(Astro.url.pathname, siteUrl || Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalHref} />
    {noindex && <meta name="robots" content="noindex" />}
    <style>
      :root {
        color-scheme: light dark;
        --fg: #101418;
        --bg: #ffffff;
        --muted: #5b6470;
      }
      @media (prefers-color-scheme: dark) {
        :root { --fg: #e8ecf1; --bg: #101418; --muted: #98a2b3; }
      }
      body {
        margin: 0;
        font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--fg);
        background: var(--bg);
      }
      main { max-width: 720px; margin: 0 auto; padding: 2rem 1rem; }
      h1 { font-size: 1.75rem; margin: 0 0 0.5rem; }
      p.muted { color: var(--muted); }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
