      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is this donation tax deductible?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "National Kidney Foundation (EIN: 13-1673104) is a 501(c)3 tax-exempt organization and your donation is tax-deductible within the guidelines of U.S. law. To claim a donation as a deduction on your U.S. taxes, please keep your email donation receipt as your official record. We'll send it to you upon successful completion of your donation."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a minimum amount I'm allowed to give?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every dollar counts. No gift is too small and makes a meaningful difference in our work to advance research, diagnosis and treatment of kidney disease."
          }
        },
        {
          "@type": "Question",
          "name": "Will I receive a donation receipt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A donation receipt will be sent to you at the email address you provide on this form. Please be sure to keep a copy of your receipt for tax purposes. We’ll also make a statement of your generosity available for download in your Account whenever you need it. Can’t find it? Contact: <u><a href=\"mailto:donations@kidney.org\" rel=\"nofollow\">Donations@kidney.org</a></u>."
          }
        },
        {
          "@type": "Question",
          "name": "How will my gift help?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your support helps us do more. More research, more advocacy, more transplants, more hope. Your generosity will ensure that NKF can continue to make transplants a priority through research, innovation and advocacy, while expanding access to programs that help patients find their perfect match."
          }
        },
        {
          "@type": "Question",
          "name": "Can I make my gift by mail or over the phone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Of course! Complete our mail-in donation form to accompany your offline donation and send it to: <br><br>Attn: Gift Processing at National Kidney Foundation HQ<br>30 East 33rd Street<br>New York, NY 10016<br><br>Or, call us to complete your gift at 212-889-2210"
          }
        },
        {
          "@type": "Question",
          "name": "Still have questions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you are experiencing any issues or have questions about your contribution, please contact <u><a href=\"mailto:donations@kidney.org\" rel=\"nofollow\">donations@kidney.org</a></u>."
          }
        }
      ]
