{
  "name": "@gof/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/cli.ts",
    "start:seed": "node --experimental-strip-types --no-warnings src/seed.ts",
    "start:live-extract": "node --experimental-strip-types src/live-extract.ts",
    "start:seed-course-types": "node --experimental-strip-types --no-warnings src/seed/course-types-cli.ts",
    "start:courses-import": "node --experimental-strip-types --no-warnings src/courses/cli.ts",
    "start:places-build": "node --experimental-strip-types --no-warnings src/places/build.ts",
    "start:places-load": "node --experimental-strip-types --no-warnings src/places/load-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@gof/db": "workspace:*",
    "@gof/shared": "workspace:*",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.13",
    "pdfjs-dist": "6.3.289",
    "tz-lookup": "6.1.25",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/tz-lookup": "6.1.2",
    "playwright": "1.63.0"
  }
}
