{
  "name": "golf-outing-finder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter @gof/site dev",
    "build": "pnpm --filter @gof/site build",
    "deploy": "pnpm --filter @gof/site deploy",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tests/e2e",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "pnpm --filter @gof/site db:migrate:local",
    "db:migrate:remote": "pnpm --filter @gof/site db:migrate:remote",
    "seed": "pnpm --filter @gof/pipeline start:seed",
    "seed:course-types": "pnpm --filter @gof/pipeline start:seed-course-types",
    "courses:import": "pnpm --filter @gof/pipeline start:courses-import",
    "places:build": "pnpm --filter @gof/pipeline start:places-build",
    "places:load": "pnpm --filter @gof/pipeline start:places-load",
    "pipeline": "pnpm --filter @gof/pipeline start",
    "test:live-extract": "pnpm --filter @gof/pipeline start:live-extract",
    "format": "prettier --write .",
    "docker:up": "docker compose up --build site",
    "docker:up:local": "docker compose -f docker-compose.yml -f docker-compose.local.yml up --build site"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^3.23.8"
  }
}
